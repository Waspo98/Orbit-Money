# ==============================================================================
# Orbit Money - Environment Configuration
# ==============================================================================
# Copy this file to `.env` and replace placeholder values with real secrets.
# Never commit `.env` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------------------
# local = username/password only
# oidc  = external OpenID Connect only
# both  = show both the local login form and the OIDC button
AUTH_PROVIDER=local

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# Required when AUTH_PROVIDER=oidc or AUTH_PROVIDER=both.
# Authentik, Authelia, Keycloak, and many other providers work through OIDC.
# Set your OIDC provider's redirect URI to:
#   https://your-orbit-domain.example/api/auth/oidc/callback
OIDC_ISSUER_URL=https://auth.example.com/application/o/orbit-money/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://your-orbit-domain.example/api/auth/oidc/callback
OIDC_SCOPES=openid email profile

# Optional text for the OIDC button on the login page.
OIDC_LOGIN_LABEL=Log in with OIDC

# ------------------------------------------------------------------------------
# Session Secret
# ------------------------------------------------------------------------------
# Used to sign session cookies. Generate a 64-character hex secret with:
#   $bytes = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   -join ($bytes | ForEach-Object { $_.ToString('x2') })
SESSION_SECRET=change_me_to_random_64_char_hex_string

# Optional. Useful when running production and beta on the same localhost.
SESSION_NAME=connect.sid

# ------------------------------------------------------------------------------
# API Key (for programmatic access via X-API-Key header; optional)
# Leave blank unless you intentionally want API-key access.
# ------------------------------------------------------------------------------
API_KEY=

# ------------------------------------------------------------------------------
# SimpleFIN Access URL Encryption Key
# ------------------------------------------------------------------------------
# Used to encrypt your SimpleFIN access URL before storing in the database.
# Required only before connecting SimpleFIN. Must be a 64-character hex string
# (32 bytes). Generate it the same way as SESSION_SECRET.
SIMPLEFIN_ENCRYPTION_KEY=

# Optional public demo mode. Set to 1 to show "Continue with sample data" on the
# login page and allow temporary sample households. Leave off for private/public
# self-hosted installs.
ENABLE_SAMPLE_DATA=0

# ------------------------------------------------------------------------------
# Merchant Logo Enrichment (optional)
# ------------------------------------------------------------------------------
# Logo.dev publishable key used to display merchant logos in transaction lists.
# Leave both blank to use category icons only. The secret key is server-side only
# and enables native brand search for manual logo overrides.
LOGO_DEV_PUBLISHABLE_KEY=
LOGO_DEV_SECRET_KEY=

# ------------------------------------------------------------------------------
# Runtime Config
# ------------------------------------------------------------------------------
PORT=5008
TZ=America/Chicago
