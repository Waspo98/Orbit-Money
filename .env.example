# ==============================================================================
# Orbit Money — Environment Configuration
# ==============================================================================
# Copy this file to `.env` and replace placeholder values with real secrets.
# Never commit `.env` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------------------
# local keeps the legacy username/password login. authentik enables OIDC login.
AUTH_PROVIDER=local

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# Required when AUTH_PROVIDER=authentik. In Authentik, create an OAuth2/OpenID
# provider and set the redirect URI to:
#   https://your-orbit-domain.example/api/auth/oidc/callback
AUTHENTIK_ISSUER_URL=https://auth.example.com/application/o/orbit-money/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://your-orbit-domain.example/api/auth/oidc/callback

# ------------------------------------------------------------------------------
# Session Secret
# ------------------------------------------------------------------------------
# Used to sign session cookies. Generate with this PowerShell one-liner:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
SESSION_SECRET=change_me_to_random_64_char_hex_string

# Optional. Useful when running production and beta on the same localhost.
SESSION_NAME=connect.sid

# ------------------------------------------------------------------------------
# API Key (for programmatic access via X-API-Key header; optional)
# ------------------------------------------------------------------------------
API_KEY=change_me_to_random_hex_string

# ------------------------------------------------------------------------------
# SimpleFIN Access URL Encryption Key
# ------------------------------------------------------------------------------
# Used to encrypt your SimpleFIN access URL before storing in the database.
# Must be a 64-character hex string (32 bytes).
SIMPLEFIN_ENCRYPTION_KEY=change_me_to_random_64_char_hex_string

# ------------------------------------------------------------------------------
# Merchant Logo Enrichment (optional)
# ------------------------------------------------------------------------------
# Logo.dev publishable key used to display merchant logos in transaction lists.
# Leave both blank to use category icons only. The secret key is server-side only
# and enables native brand search for manual logo overrides.
LOGO_DEV_PUBLISHABLE_KEY=
LOGO_DEV_SECRET_KEY=

# ------------------------------------------------------------------------------
# Runtime Config
# ------------------------------------------------------------------------------
PORT=5008
TZ=America/Chicago
